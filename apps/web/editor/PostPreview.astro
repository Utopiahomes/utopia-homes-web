---
// The owner's new post, before it exists (Stoin Sites editor, 2026-11-19). Built only into the edit
// copy, at /_stoin/post. It holds no post: the editor sends the draft in through the bridge, which
// fills these slots with text only. The markup follows pages/blog/[slug].astro so the draft looks
// like the article it becomes.
import BaseLayout from "../src/layouts/BaseLayout.astro";
import { content } from "../src/lib/content";
const copy = content.thinking.article;
---

<BaseLayout title="New post" pathname="/_stoin/post" type="article" noindex>
  <article class="article-page article-page-editorial" data-stoin-post>
    <header class="article-header article-header-editorial">
      <div class="shell-narrow article-header-content">
        <p class="article-meta" data-stoin-post-meta></p>
        <h1 data-stoin-key="post.title" data-placeholder="Title"></h1>
        <p class="article-subtitle" data-stoin-key="post.subtitle" data-placeholder="Subtitle (optional)"></p>
        <p class="article-byline">{copy.byline} CB Wilkinson</p>
      </div>
    </header>
    <figure class="article-editorial-hero shell" data-stoin-post-photo>
      <img data-stoin-image="post.photo" alt="" width="1200" height="630" />
    </figure>
    <div class="article-body shell-reading" data-stoin-post-body></div>
  </article>
</BaseLayout>
