# Optional canonical origin used to generate absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# VERCEL_ENV is supplied automatically by Vercel. Preview and local builds are noindex.
# Analytics is intentionally provider-agnostic in local development.
NEXT_PUBLIC_ANALYTICS_PROVIDER=console

# Public Lucy remains absent unless this server-only flag and every value below are set.
LUCY_PUBLIC_ENABLED=false
# Exact HTTPS answer endpoint exposed by the reviewed Cloud Lucy release.
LUCY_PUBLIC_API_URL=
# Dedicated, minimum-32-character website-to-Lucy bearer; never prefix with NEXT_PUBLIC_.
LUCY_PUBLIC_API_TOKEN=
# Exact public site binding used by Cloud Lucy's approved public projection.
LUCY_PUBLIC_SITE_HOSTNAME=www.utopiahomes.com
# Exact owner-approved Cloud Lucy snapshot digest; responses from any other version fail closed.
# Set only when Cloud Lucy has activated the matching projection.
# Approved R1 test-corpus digest: 95e2e20a9e4a3786e3daa63a73bb5ff2866b5bae295e6dc138bf432e4361c422
LUCY_PUBLIC_SNAPSHOT_DIGEST=
# Optional separately reviewed, still-eligible rollback projection digest.
LUCY_PUBLIC_ROLLBACK_SNAPSHOT_DIGEST=

# /api/lucy answer backend, chosen by the operator. Unset (the default) keeps the legacy Public Lucy
# upstream above. "homes-prime" sends questions to Utopia Homes Prime (guest.answer@1.0) instead.
# Switching back is the rollback; there is no automatic per-request fallback. LUCY_PUBLIC_ENABLED
# and LUCY_PUBLIC_SITE_HOSTNAME still apply to both backends.
LUCY_ANSWER_BACKEND=
# Homes Prime's exact HTTPS /business/v1/guest/answer URL.
HOMES_PRIME_GUEST_ANSWER_URL=
# The website adapter's own Ed25519 private key PEM (PKCS#8). Homes Prime holds only the public key.
HOMES_PRIME_GUEST_ANSWER_JWT_PRIVATE_KEY_PEM=
# Matching kid, registered in Homes Prime's JWT key allowlist with the guest.answer capability.
HOMES_PRIME_GUEST_ANSWER_JWT_KID=

# ISOLATED PREVIEW ONLY (app/api/lucy-preview, not the live /api/lucy route — see
# docs/guest-answer-preview.md). Absent unless every value below is set. Never a production key.
PREVIEW_GUEST_ANSWER_ENABLED=false
# The running utopia-homes-guest-answer-provider's /business/v1/guest/answer URL.
PREVIEW_GUEST_ANSWER_PROVIDER_URL=
# Ephemeral, locally-generated, preview-environment-only Ed25519 private key PEM.
PREVIEW_GUEST_ANSWER_JWT_PRIVATE_KEY_PEM=
# Matching kid; must be in the provider's preview-environment JWT key allowlist.
PREVIEW_GUEST_ANSWER_JWT_KID=

# Durable form storage. Use memory only for local development and tests.
SUBMISSION_STORE=memory
# Quote records use the same provider by default; set explicitly when needed.
DESIGN_QUOTE_STORE=memory
# Keep disabled until Ray approves and configures the consultation scheduler.
DESIGN_SCHEDULER_ENABLED=false
DESIGN_SCHEDULER_URL=
DESIGN_QUOTE_EMAILS_ENABLED=false
DESIGN_UNCONVERTED_RETENTION_MONTHS=12
DESIGN_PROJECT_RECORD_RETENTION_YEARS=7
RETENTION_POLICY_VERSION=2026-08-29.v3
RETENTION_DELETION_ENABLED=false
RETENTION_BATCH_SIZE=25
RETENTION_MAX_ATTEMPTS=5
RETENTION_BACKUP_MAX_DAYS=35
# Origin used by the retention CLI, normally a protected preview or localhost.
RETENTION_ADMIN_ORIGIN=http://127.0.0.1:3000
RETENTION_OPERATOR=
SUPABASE_URL=
# Server-only elevated key beginning with sb_secret_. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Transactional email. Keep every credential server-only in Vercel.
EMAIL_PROVIDER=proton
PROTON_SMTP_USER=ray@utopiahomes.com
# Generate this one-time SMTP token in Proton. Never use the normal account password.
PROTON_SMTP_TOKEN=
PROTON_SMTP_FROM="Utopia Homes <ray@utopiahomes.com>"
# Inactive alternative provider retained for future use when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Utopia Homes <notifications@updates.utopiahomes.com>"
# Temporary centralized destination for every operational form notification.
LEAD_NOTIFICATION_EMAIL=ray@utopiahomes.com
SEND_CONFIRMATION_EMAILS=false
# Set false to pause email delivery/retries while continuing to capture leads.
NOTIFICATION_EMAIL_ENABLED=true
# Random 16+ character secret used only to authenticate Vercel Cron requests.
CRON_SECRET=
