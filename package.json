{
  "name": "utopia-homes-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "check": "pnpm --dir apps/web check && pnpm test && pnpm test:editor",
    "test": "vitest run",
    "test:editor": "node --test tests/site-editor.test.mjs",
    "static:check": "node scripts/validate-static-site.mjs",
    "seo:build": "node scripts/seo-build.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "retention:dry-run": "node scripts/retention.mjs dry-run",
    "retention:run": "node scripts/retention.mjs run",
    "retention:status": "node scripts/retention.mjs status",
    "retention:retry-failures": "node scripts/retention.mjs run",
    "retention:delete-record": "node scripts/retention.mjs delete-record",
    "retention:place-legal-hold": "node scripts/retention.mjs place-legal-hold",
    "retention:release-legal-hold": "node scripts/retention.mjs release-legal-hold"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "jose": "^6.2.12",
    "nodemailer": "^9.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@vercel/node": "^32.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.2",
    "vitest": "^5.0.1"
  }
}
